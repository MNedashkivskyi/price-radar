# Staging Environment Variables Template
# Copy this to .env.staging and fill in the values

# Database
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/price_radar

# Redis
REDIS_URL=redis://host:6379/0
CELERY_BROKER_URL=redis://host:6379/1
CELERY_RESULT_BACKEND=redis://host:6379/2

# Application
APP_NAME=Price Radar API
DEBUG=false

# Shopify OAuth
SHOPIFY_API_KEY=your-shopify-api-key-from-partner-dashboard
SHOPIFY_API_SECRET=your-shopify-api-secret-from-partner-dashboard
SHOPIFY_APP_URL=https://your-app.railway.app
SHOPIFY_SCOPES=read_products,write_products,read_orders
SHOPIFY_API_VERSION=2024-01

# JWT Authentication
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=your-32-byte-or-longer-secret-key-here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Frontend
FRONTEND_URL=https://your-frontend.railway.app

# Port (usually set by hosting provider)
PORT=8000
