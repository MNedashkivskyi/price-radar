# Application
APP_NAME="Price Radar API"
DEBUG=true

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/price_radar

# Redis
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Shopify App Credentials
SHOPIFY_API_KEY=your_shopify_api_key_here
SHOPIFY_API_SECRET=your_shopify_api_secret_here
SHOPIFY_APP_URL=http://localhost:8000
SHOPIFY_SCOPES=read_products,write_products,read_orders
SHOPIFY_API_VERSION=2024-01

# Encryption (Fernet key for encrypting Shopify access tokens in DB)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If not set, a key is derived from SHOPIFY_API_SECRET automatically
ENCRYPTION_KEY=

# JWT (generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
JWT_SECRET_KEY=change_me_to_a_random_secret

# Frontend
FRONTEND_URL=http://localhost:3000

# Proxy — Decodo (Smartproxy) residential proxy
# Single endpoint (simple setup):
# DECODO_PROXY_URL=http://user:pass@gate.smartproxy.com:10001
#
# Multiple endpoints (recommended — round-robin rotation across pool):
# Comma-separated list of proxy gateway URLs.  Spreads traffic across
# endpoints to improve throughput and avoid per-endpoint rate limits.
# DECODO_PROXY_URLS=http://user:pass@gate.smartproxy.com:10001,http://user:pass@gate.smartproxy.com:10002,...

# Decodo Web Scraping API (last-resort tier for CAPTCHA-blocked sites)
# DECODO_API_TOKEN=
